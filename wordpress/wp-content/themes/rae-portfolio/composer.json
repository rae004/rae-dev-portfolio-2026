{
    "name": "rae004/rae-portfolio",
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.2"
    },
    "authors": [
        {
            "name": "Robert Engel",
            "email": "robert.engel@apollidon.com"
        }
    ],
    "require": {},
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "phpcs": "vendor/bin/phpcs --standard=./ruleset.xml --extensions=php --ignore=./assests,./styles,.vendor/,./node_modules -ps .",
        "phpcs:fix": "vendor/bin/phpcbf --standard=./ruleset.xml --extensions=php --ignore=./assests,./styles,.vendor/,./node_modules -ps .",
        "phpcs:standards": "vendor/bin/phpcs -i",
        "phpcs:wordpress:rules": "vendor/bin/phpcs -e --standard=WordPress"
    }
}
