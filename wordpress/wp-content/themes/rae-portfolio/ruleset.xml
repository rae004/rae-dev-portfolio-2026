<?xml version="1.0"?>
<ruleset name="RaeDevWordPressCodingStandard">
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/src/Standards/Generic/ruleset.xml">
    <description>Ruleset for RAE Dev WordPress PHP Development</description>

    <!-- Alternative Standards -->
    <!--    <rule ref="PSR2"/>-->
    <!--    <rule ref="PEAR"/>-->
    <!--    <rule ref="PSR1"/>-->
    <!--    <rule ref="PSR12"/>-->
    <!--    <rule ref="Squiz"/>-->
    <!--    <rule ref="Zend"/>-->
    <!--    <rule ref="Universal"/>-->

    <rule ref="Modernize"/>
    <rule ref="NormalizedArrays"/>
    <rule ref="PHPCSUtils"/>
    <rule ref="WordPress">
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar" />
        <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop" />
    </rule>

    <!--  All These are included in WordPress  -->
    <!--    <rule ref="WordPress-Core"/>-->
    <!--    <rule ref="WordPress-Docs"/>-->
    <!--    <rule ref="WordPress-Extra"/>-->

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="135"/>
            <property name="absoluteLineLimit" value="145"/>
        </properties>
    </rule>

    <!-- Exclude the filename rule for the tests directory -->
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Exclude the InvalidClassFileName rule for the tests directory -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>