# Supply chain hardening — see documentation/supply_chain_hardening.md
#
# Lambda deps are @aws-sdk/* clients only — no native modules, no legitimate
# postinstall need. Block all install scripts as a containment layer in case
# a poisoned version of an SDK package were ever published.
#
# Cooldown is enforced via Renovate (.github/renovate.json), not .npmrc,
# because npm does not support minimum-release-age.

ignore-scripts=true
fund=false
