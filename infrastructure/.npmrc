# Supply chain hardening — see documentation/supply_chain_hardening.md

# 7-day cooldown before installing any newly published version.
# Mitigates time-window supply chain attacks like the TanStack 2026-05-11
# incident, where poisoned versions were live on npm for ~6 minutes.
minimum-release-age=10080

# Per-package bypass list. Leave empty in normal operation; populate only
# for emergency CVE patches that need to land before the 7-day wall lifts.
# Example: minimum-release-age-exclude=aws-cdk,aws-cdk-lib
minimum-release-age-exclude=

# Refuse to install if pnpm-lock.yaml would change.
frozen-lockfile=true

# Refuse to run scripts if the lockfile drifted from the store.
verify-deps-before-run=true

# Quality-of-life.
fund=false
auto-install-peers=true
