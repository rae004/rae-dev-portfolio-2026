# AWS CDK Environment Configuration
# Copy this file to .env and fill in your values.
#
# IMPORTANT: DEV_DOMAIN / PROD_DOMAIN are the APEX domain that this stack
# composes subdomains from — they are NOT the deployed FQDN. Inside the stack:
#
#   const frontendFqdn = envName === 'prod' ? domainName : `${envName}.${domainName}`
#   const apiFqdn      = envName === 'prod' ? `api.${domainName}` : `api-dev.${domainName}`
#
# So with DEV_DOMAIN=rae-dev.com the dev stack produces dev.rae-dev.com and
# api-dev.rae-dev.com. Setting DEV_DOMAIN=dev.rae-dev.com would yield
# dev.dev.rae-dev.com and a HostedZone.fromLookup failure.

# Development Environment
DEV_CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID
DEV_DOMAIN=rae-dev.com

# Production Environment — leave both blank until prod is actually provisioned.
# A non-empty PROD_CERTIFICATE_ARN forces the prod stack to call
# HostedZone.fromLookup, which fails synth/diff on every other stack too.
PROD_CERTIFICATE_ARN=
PROD_DOMAIN=

# AWS Configuration
AWS_REGION=us-east-1
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
